# Set these as Codespaces secrets, in repository .env, or in the local parent ../.env.
# All files are optional; process environment takes precedence. Never commit real keys.
JEV_API_KEY=
JEV_API_URL=https://api.typesafe.ai/v1/systemone
JEV_MODEL=jev-latest
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=
# Includes hidden reasoning plus visible JSON. Optional; default 8192.
OPENAI_MAX_COMPLETION_TOKENS=8192
DEEP_SEEK_API_KEY=
DEEP_SEEK_BASE_URL=https://api.deepseek.com
DEEP_SEEK_MODEL=

# Local book retrieval for JEV and DeepSeek; false disables it for baseline comparisons.
CHESS_RAG_ENABLED=true

# Optional for a non-Codespaces reverse proxy; Codespaces sets this automatically.
# APP_ORIGIN=https://your-private-host.example
